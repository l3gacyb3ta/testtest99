  "narrative": {
    "northStar": "Two worlds: \"The Production Line\" (landing) and \"The Field Notebook\" (platform)",
    "overview": "Half Life runs two visual worlds on purpose. The marketing site sells a ten-week hardware programme to teenagers who have never soldered anything; the platform is where those teenagers then work, for ten weeks, most days. The landing page is a production line drawn as the line itself: flat plates, hard square corners, no shadows, an ink ground, and a thick band welding each stage to the next. The platform is a field notebook: every outline a drawn ink stroke, the week arriving as torn painted paper, structure expressed as a path you walk rather than a page you read.",
    "keyCharacteristics": [
      "Two grounds, never mixed: #31222c ink for the landing, #fcf7f7 warm paper for the platform.",
      "The landing has no shadows and no rounded corners; the platform has drawn edges and one solid drop.",
      "The platform's primary structure is a progress path, not a dashboard of cards.",
      "Illustration is the programme's own: gato characters and five theme paintings, all die-cut stickers.",
      "Secondary text is tinted from its surface, never neutral grey."
    ],
    "rules": [
      {
        "name": "The Two Worlds Rule",
        "body": "A token from one world never appears in the other. The two palettes do not share a single value.",
        "section": "colors"
      },
      {
        "name": "The Tinted Secondary Rule",
        "body": "Secondary text is tinted from its own surface, never neutral grey.",
        "section": "colors"
      },
      {
        "name": "The Misnamed Yellow Rule",
        "body": "--color-hl-yellow and --color-hl-yellow-pale are blue. The landing was recoloured and the names were never updated. Trust the value, not the name.",
        "section": "colors"
      },
      {
        "name": "The Brush Bookends Rule",
        "body": "Masterpiece is identity, never voice: the wordmark and the footer's column labels, and never bold.",
        "section": "typography"
      },
      {
        "name": "The Comico Is Not Body Rule",
        "body": "The accent face is for uppercase labels and numerals. No licensed file ships yet, so it falls back through one variable.",
        "section": "typography"
      },
      {
        "name": "The Outline-Not-Shadow Rule",
        "body": "Depth on the platform comes from a drawn outline and the ground showing through, never from a shadow.",
        "section": "elevation"
      },
      {
        "name": "The One Solid Drop Rule",
        "body": "The zero-blur drop belongs to the checkpoint node and nothing else.",
        "section": "elevation"
      },
      {
        "name": "The Drawn Edge Rule",
        "body": "A platform border is drawn, not stroked. Vary the seed between adjacent cards.",
        "section": "shapes"
      },
      {
        "name": "The Filter Applies To The Edge Rule",
        "body": "The displacement filter goes on the border element only. Filtering an element that holds text turns the text to mush.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do pick the world first \u2014 palette, type, edge treatment and radius all follow from it.",
      "Do draw platform borders with WobbleBorder and vary the seed between neighbouring cards.",
      "Do tint secondary text from its surface.",
      "Do dim the current nav item rather than highlighting it.",
      "Do give every focusable surface the shared 3px accent ring at 2px offset.",
      "Do put the content column first when the platform collapses to one column.",
      "Do state a checkpoint's next action on the current node only, and leave locked nodes unlinked."
    ],
    "donts": [
      "Don't mix the two palettes, or put a platform component on a landing page.",
      "Don't add a shadow to a platform card.",
      "Don't use teal, coin or flame for body-size text until their contrast is resolved (2.64:1, 1.87:1, 3.13:1 on the page ground).",
      "Don't trust --color-hl-yellow*: those variables hold blues.",
      "Don't set Masterpiece in bold.",
      "Don't apply the wobble filter to anything containing text.",
      "Don't nest cards.",
      "Don't use a Unicode glyph as an icon."
    ]
  }
}
